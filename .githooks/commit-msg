#!/bin/sh
# Valida formato y trailers del mensaje de commit (ver gestion/README.md).
# Se activa una vez por clon con: git config core.hooksPath .githooks
if command -v python >/dev/null 2>&1; then
    exec python "$(dirname "$0")/commit_msg.py" "$1"
fi
exec py -3 "$(dirname "$0")/commit_msg.py" "$1"
