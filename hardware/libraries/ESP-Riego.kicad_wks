(kicad_wks
	(version 20231118)
	(generator "pl_editor")
	(generator_version "9.0")
	(setup
		(textsize 1.5 1.5)
		(linewidth 0.15)
		(textlinewidth 0.15)
		(left_margin 10)
		(right_margin 10)
		(top_margin 10)
		(bottom_margin 10)
	)
	(rect
		(name "")
		(start 180 45)
		(end 2 2)
		(comment "rect around the title block")
	)
	(rect
		(name "")
		(start 0 0 ltcorner)
		(end 0 0)
		(repeat 2)
		(incrx 2)
		(incry 2)
	)
	(line
		(name "")
		(start 50 2 ltcorner)
		(end 50 0 ltcorner)
		(repeat 30)
		(incrx 50)
	)
	(tbtext "1"
		(name "")
		(pos 25 1 ltcorner)
		(font
			(size 1.3 1.3)
		)
		(repeat 100)
		(incrx 50)
	)
	(line
		(name "")
		(start 50 2 lbcorner)
		(end 50 0 lbcorner)
		(repeat 30)
		(incrx 50)
	)
	(tbtext "1"
		(name "")
		(pos 25 1 lbcorner)
		(font
			(size 1.3 1.3)
		)
		(repeat 100)
		(incrx 50)
	)
	(line
		(name "")
		(start 0 50 ltcorner)
		(end 2 50 ltcorner)
		(repeat 30)
		(incry 50)
	)
	(tbtext "A"
		(name "")
		(pos 1 25 ltcorner)
		(font
			(size 1.3 1.3)
		)
		(justify center)
		(repeat 100)
		(incry 50)
	)
	(line
		(name "")
		(start 0 50 rtcorner)
		(end 2 50 rtcorner)
		(repeat 30)
		(incry 50)
	)
	(tbtext "A"
		(name "")
		(pos 1 25 rtcorner)
		(font
			(size 1.3 1.3)
		)
		(justify center)
		(repeat 100)
		(incry 50)
	)
	(tbtext "Date: ${ISSUE_DATE}"
		(name "")
		(pos 28.5802 41.1902)
	)
	(tbtext "${KICAD_VERSION}"
		(name "")
		(pos 53.1202 4.1002)
		(comment "Kicad version")
	)
	(line
		(name "")
		(start 132 20)
		(end 132 2)
	)
	(tbtext "Size: ${PAPER}"
		(name "")
		(pos 16 22)
		(justify center)
		(comment "Paper format name")
	)
	(tbtext "Id: ${#}/${##}"
		(name "")
		(pos 16 4.1)
		(justify center)
		(comment "Sheet id")
	)
	(line
		(name "")
		(start 32 37)
		(end 2 37)
	)
	(tbtext "File: ${FILENAME}"
		(name "")
		(pos 177.5802 22.9202)
		(font
			(size 1.8 1.8)
		)
	)
	(line
		(name "")
		(start 180 20)
		(end 2 20)
	)
	(line
		(name "")
		(start 32 45)
		(end 32 2)
	)
	(tbtext "${TITLE}"
		(name "")
		(pos 130.5 10)
		(font
			(size 2.5 2.5) bold)
		(comment "Titulo")
	)
	(tbtext "Hoja: ${SHEETNAME}"
		(name "")
		(pos 130.5 17.5)
		(font
			(size 2 2)
		)
	)
	(tbtext "Rev: ${REVISION}"
		(name "")
		(pos 130.5 4.1)
		(font
			(size 1.8 1.8)
		)
	)
	(tbtext "${COMPANY}"
		(name "")
		(pos 177.5 17)
		(font
			(size 1.8 1.8)
		)
		(justify top)
		(comment "Company name")
	)
	(tbtext "${COMMENT1}"
		(name "")
		(pos 177.5 40)
		(font
			(size 3.5 3.5) bold)
		(comment "Comment 1")
	)
)
