	(text "3,3 V, LED Y VIN_SENSE (ALI-07, ALI-09 … 11)"
		(exclude_from_sim no)
		(at 304.8 149.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1e002920-4020-4306-81db-9fa2b4851a52")
	)
	(text "I_OL = 18,09 / R2 [kΩ] → 3,86–4,57 A. MODE abierto = latch-off; rearme con flanco de LIM_EN (SHDN).\nR5 mantiene el bus apagado en reset y flasheo. UVLO, PGTH y PLIM a GND; B_GATE, DRV y PGOOD sin conectar.\nIMON: 0,279 V/A con R3; R4 + C5 hacia el ADC1 (6 dB). §3.13"
		(exclude_from_sim no)
		(at 205.74 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "34698529-869b-4294-ab27-26715accb040")
	)
	(text "LIMITADOR COMÚN DEL BUS: U1 TPS26632 (ALI-12, ALI-13, REL-04)"
		(exclude_from_sim no)
		(at 205.74 38.1 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "475e96ea-e14c-42e4-b445-affe9d6989c9")
	)
	(text "U4 TLV1117LV 1 A (§3.9). D4 rojo en +3V3 (§3.11).\nVIN_SENSE = VIN_PROT / 21,53 → ADC1 a 6 dB (§3.10). TP1–TP5: §3.12"
		(exclude_from_sim no)
		(at 304.8 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "59d3d190-787c-44d9-96df-50c5e8d69a38")
	)
	(text "UNIÓN USB / 5 V: U3 TPS2116 (ALI-08)"
		(exclude_from_sim no)
		(at 205.74 149.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "71e80450-5775-4766-9235-0a3d794dca8a")
	)
	(text "VOUT = 1 V · (1 + R7/R8) = 5,016 V (R7, R8 al 0,1 %). UVLO: R9/R10 → arranque 12,50–14,56 V (DEC-0006).\nCIN de U2 = C7 + C22 (4,7 µF 100 V) + C8 220 nF, junto a VIN–PGND. C2 es del nodo de entrada. §3.6–§3.7"
		(exclude_from_sim no)
		(at 25.4 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "73c12875-e4cd-408d-87be-086767043ef0")
	)
	(text "J1 (+24 V en el polo 1) → F1 10 A → Q1 P-MOS de polaridad (D1 limita V_GS a 15 V) → VIN_PROT.\nD2 SMBJ33A unidireccional después de Q1 (Vc 53,3 V; nodo ≥ 58,6 V). docs/diseno/alimentacion.md §3.1–§3.5"
		(exclude_from_sim no)
		(at 25.4 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "767b97d7-7eda-40ec-b9b1-b32e82474201")
	)
